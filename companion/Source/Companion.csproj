<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The companion mod, one build per game version, from the same source:
    - net472 for RimWorld 1.6 (Unity), against the installed game ($(RimWorldManaged));
    - net10.0 for RimWorld 1.7, against the reference assemblies from NuGet. The earliest 1.7
      build: a mod built against a newer game may not load on an older one.
    Build with companion/build.ps1: it finds the game and puts the dlls into
    companion/<version>/Assemblies, which are committed (CI has no game to build against).
  -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <AssemblyName>RimWorldModManagerCompanion</AssemblyName>
    <RootNamespace>RimWorldModManagerCompanion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <OutputPath Condition="'$(TargetFramework)' == 'net472'">..\1.6\Assemblies\</OutputPath>
    <OutputPath Condition="'$(TargetFramework)' == 'net10.0'">..\1.7\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Without the framework in the output path both builds would share one obj folder. -->
    <IntermediateOutputPath>obj\$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <!-- No RimWorld 1.6 installed (-p:RimWorldManaged is empty): its reference assemblies from NuGet. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' And '$(RimWorldManaged)' == ''">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472' And '$(RimWorldManaged)' != ''">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4977-alpha.1" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
